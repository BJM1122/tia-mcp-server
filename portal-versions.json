    },
    {
      "id": "importer", "adapters": ["live-core", "v15-snapshot"], "buildCapability": "block_import", "baseName": "TiaOpennessImportBlock", "outputDir": "tools",
      "sources": ["live-core/TiaOpennessImportBlock.cs"], "selfTestArgs": ["--self-test", "--api", "{api}"]
    },
