      "sources": ["live-core/TiaHmiNative.cs", "live-core/TiaHmiProject.cs", "live-core/TiaHmiUnified.cs"], "selfTestArgs": ["{api}", "--self-test"]
    },
    {
      "id": "v15-snapshot", "adapters": ["v15-snapshot"], "buildCapability": "snapshot_export", "baseName": "TiaV15Snapshot", "outputDir": "tools",
